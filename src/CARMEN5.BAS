10 REM CARMEN SANDIEGO - VERSION SC5 MSX2 BASIC
20 MAXFILES=2:CLEAR 8000:SCREEN 5,0:WIDTH 32:COLOR 15,1,1:KEY OFF:CLS:PRESET(0,0)
22 OPEN "GRP:" FOR OUTPUT AS #2
