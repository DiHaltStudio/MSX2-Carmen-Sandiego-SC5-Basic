1340 LINE INPUT #1,ZC$
1350 LINE INPUT #1,ZO$
1360 LINE INPUT #1,ZU$
1370 LINE INPUT #1,ZM$
1380 LINE INPUT #1,ZI$
1385 LINE INPUT #1,Z1$
1387 LINE INPUT #1,Z2$
1390 FOR I=1 TO 3:LINE INPUT #1,ZP$(I):NEXT I
1395 CLOSE #1:RETURN
1400 REM RUTINA ELEGIR FILTRO ORDEN
1410 A$=MID$(STR$(CA),2):FI$="ATTR"+A$+".DAT"
1420 OPEN FI$ FOR INPUT AS #1
1430 LINE INPUT #1,A$:NA=VAL(A$)
1440 FOR I=1 TO NA:LINE INPUT #1,AV$(I):NEXT I
1450 CLOSE #1
1460 CLS:PRESET(0,0):PRINT #2, K$(CA)
1470 O$(1)="SIN DATO"
1480 FOR I=1 TO NA:O$(I+1)=AV$(I):NEXT I
1490 MN=NA+1:MY=2:GOSUB 2300:OP=OP-1
1492 IF OP<0 OR OP>NA THEN PRINT #2, "VALOR NO VALIDO":GOSUB 1800:RETURN
1494 IF OP=0 THEN EV%(CA)=0:ES$(CA)="":WA=0:RETURN
1496 EV%(CA)=OP:ES$(CA)=AV$(OP):WA=0:RETURN
1500 REM RUTINA CALCULAR ORDEN
1510 TM=TM+1:CT=0:LM=0
1512 CLS:PRESET(0,0)
1515 PRINT #2,"":PRINT #2, "CONSULTA: +1 HORA"
1518 OPEN "SUSPECT.DAT" FOR INPUT AS #1
1519 LINE INPUT #1,A$
1520 FOR I=1 TO NS
1530 LINE INPUT #1,A$
1532 FOR J=1 TO 5:LINE INPUT #1,B$:SA%(J)=VAL(B$):NEXT J
1535 GOSUB 1600
1538 IF DT%(I)<>0 THEN OK=0
1540 MA%(I)=OK:IF OK=1 THEN CT=CT+1:LM=I
1550 NEXT I
1555 CLOSE #1
1560 PRINT #2,""
1570 IF CT=1 THEN WA=LM:PRINT #2, "ORDEN EMITIDA CONTRA ";S$(WA):GOSUB 1850:RETURN
1580 WA=0
1590 IF CT=0 THEN PRINT #2, "NINGUN SOSPECHOSO COINCIDE.":GOSUB 1850:RETURN
1592 PRINT #2, "COINCIDEN ";CT;" SOSPECHOSOS:"
1594 FOR I=1 TO NS:IF MA%(I)<>0 THEN PRINT #2, "- ";S$(I)
1598 NEXT I
1599 PRINT #2, "NECESITAS MAS DATOS.":GOSUB 1850:RETURN
1600 REM RUTINA COMPARAR SOSPECHOSO
1610 OK=1
1620 FOR J=1 TO 5
1630 IF EV%(J)<>0 AND EV%(J)<>SA%(J) THEN OK=0
1640 NEXT J
1670 RETURN
1680 REM RUTINA TEXTO ATRIBUTO
1682 A$=MID$(STR$(CA),2):FI$="ATTR"+A$+".DAT"
1684 OPEN FI$ FOR INPUT AS #1
1685 LINE INPUT #1,A$
1686 FOR J=1 TO VL:LINE INPUT #1,VV$:NEXT J
1688 CLOSE #1:RETURN
1700 REM RUTINA MOSTRAR PISTA IDENTIDAD
1710 AT=PA%(ST):IF AT<1 THEN AT=ST
1715 CLS:PRESET(0,0) 
1720 PRINT #2, "PISTA DE IDENTIDAD:"
