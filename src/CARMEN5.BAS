2300 REM RUTINA MENU CON CURSOR
2310 OP=1
2315 LINE(0,MY*8)-(155,(MY+MN)*8+7),1,BF
2320 FOR I=1 TO MN
2330 PRESET(16,(MY+I-1)*8)
2340 T$=O$(I):'LEFT$(O$(I),13)
2350 PRINT #2, T$:';SPACE$(14-LEN(T$));
2360 NEXT I
2365 PUT SPRITE 0,(0,(MY+OP-1)*8),10,0
2370 A$=INKEY$:IF A$="" THEN GOTO 2370
2380 IF A$=CHR$(30) OR A$=CHR$(11) THEN OP=OP-1:GOTO 2390
2385 IF A$=CHR$(31) OR A$=CHR$(10) THEN OP=OP+1:GOTO 2390
2387 IF A$=" " OR A$=CHR$(13) THEN PUT SPRITE 0,(0,211),10,0:RETURN
2388 N=VAL(A$):IF N>=1 AND N<=MN THEN OP=N:PUT SPRITE 0,(0,211),10,0:RETURN
2389 GOTO 2370
2390 IF OP<1 THEN OP=MN
2392 IF OP>MN THEN OP=1
2394 GOTO 2365
