145 GOSUB 2400
150 PRINT #2,""
160 O$(1)="INVESTIGAR":O$(2)="VIAJAR"
170 O$(3)="VER SOSPECHOSOS":O$(4)="EMITIR ORDEN"
180 O$(5)="ESTADO DEL CASO":O$(6)="ARRESTAR":O$(7)="SALIR"
190 MN=7:MY=10:GOSUB 2300
250 IF OP=7 THEN 880
260 IF OP<1 OR OP>6 THEN PRINT #2, "OPCION NO VALIDA":GOSUB 1800:GOTO 100
