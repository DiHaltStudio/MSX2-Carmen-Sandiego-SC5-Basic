415 PRINT #2,""
420 FOR I=1 TO 3:DN=FO%(I):O$(I)=C$(DN):NEXT I
425 O$(4)="NO VIAJAR":MN=4:MY=2:GOSUB 2300
430 IF OP=4 THEN RETURN
