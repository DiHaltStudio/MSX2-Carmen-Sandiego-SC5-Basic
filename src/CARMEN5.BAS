355 IF ST=RL THEN GOTO 375
360 LC=R%(ST+1):GOSUB 1300
365 IF OP=LP%(ST) THEN GOSUB 1700:GOTO 374
366 CLS:PRESET(0,0)
367 IF OP=1 THEN PRINT #2, "PREGUNTO POR ";ZM$;"."
370 IF OP=2 THEN PRINT #2, "CAMBIO DINERO POR ";ZU$;"."
372 IF OP=3 THEN PRINT #2, "COMPRO ";ZI$;"."
