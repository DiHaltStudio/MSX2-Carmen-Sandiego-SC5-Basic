440 CP=FO%(OP):TM=TM+6
445 CLS:PRESET(0,0):PRINT #2, "HAS VIAJADO A ";C$(CP)
450 IF ST<RL AND CP=R%(ST+1) THEN ST=ST+1:PRINT #2, "LA PISTA ERA CORRECTA."
455 IF CP<>R%(ST) THEN PRINT #2, "PARECE UNA PISTA FALSA."
460 GOSUB 1000
465 GOSUB 1850:GOSUB 1800:RETURN
500 REM RUTINA VER SOSPECHOSOS
505 CLS:PRESET(0,0)
510 PRINT #2, "SOSPECHOSOS"
515 PRINT #2,""
520 FOR I=1 TO NS
522 IF DT%(I)<>0 THEN PRINT #2, "* "; ELSE PRINT #2, "  ";
524 PRINT #2, " ";S$(I)
526 NEXT I
530 GOSUB 1800:RETURN
600 REM RUTINA EMITIR ORDEN
605 CLS:PRESET(0,0)
610 PRINT #2, "ORDEN DE ARRESTO"
615 PRINT #2,""
620 FOR I=1 TO 5
625 IF EV%(I)=0 THEN O$(I)=K$(I)+": -" ELSE O$(I)=K$(I)+": "+ES$(I)
635 NEXT I
645 O$(6)="CALCULAR ORDEN"
650 O$(7)="LIMPIAR FILTROS"
655 O$(8)="VOLVER"
660 MN=8:MY=2:GOSUB 2300
670 IF OP>=1 AND OP<=5 THEN CA=OP:GOSUB 1400:GOTO 605
675 IF OP=6 THEN GOSUB 1500:GOSUB 1800:RETURN
680 IF OP=7 THEN GOTO 692
685 IF OP=8 THEN RETURN
690 PRINT #2, "OPCION NO VALIDA":GOSUB 1800:GOTO 605
692 FOR I=1 TO 5:EV%(I)=0:ES$(I)="":NEXT I
694 WA=0:GOTO 605
700 REM RUTINA ESTADO DEL CASO
705 CLS:PRESET(0,0)
710 PRESET(0,0):PRINT #2, "ESTADO DEL CASO"
715 PRESET(0,16):PRINT #2, "CIUDAD: ";LEFT$(C$(CP),22)
720 PRESET(0,24):PRINT #2, "DET:";AR;"/";MX;" PISTA:";ST;"/";RL
725 PRESET(0,32):PRINT #2, "TIEMPO:";TM;"/";TL;" HORAS"
730 PRESET(0,40):IF WA=0 THEN PRINT #2, "ORDEN: SIN EMITIR" ELSE PRINT #2, "ORDEN: ";LEFT$(S$(WA),23)
745 PRESET(0,56):PRINT #2, "FILTROS:"
750 FOR I=1 TO 5
755 X=0:Y=8+INT((I-1)/2):IF I/2=INT(I/2) THEN X=128
756 PRESET(X,Y*8):PRINT #2, LEFT$(K$(I),7);":";
760 IF EV%(I)=0 THEN PRINT #2, "-" ELSE PRINT #2, LEFT$(ES$(I),7)
765 NEXT I
770 PRESET(0,12*8):PRINT #2, "RUTA:"
775 FOR I=1 TO ST:X=0:Y=13+INT((I-1)/2):IF I/2=INT(I/2) THEN X=128
776 PRESET(X,Y*8):PRINT #2, "-";LEFT$(C$(R%(I)),14):NEXT I
777 PRESET(0,17*8):PRINT #2, "VISITADAS:":J=0:QN=0
778 FOR I=1 TO NC:IF V%(I)<>0 THEN J=J+1
779 IF V%(I)<>0 AND QN<12 THEN X=0:Y=18+INT(QN/2):IF QN/2<>INT(QN/2) THEN X=128
780 IF V%(I)<>0 AND QN<12 THEN PRESET(X,Y*8):PRINT #2, "-";LEFT$(C$(I),14):QN=QN+1
781 NEXT I
782 IF J>QN THEN PRESET(176,24*8):PRINT #2, "+MAS"
790 PRESET(0,24*8):PRINT #2, "PULSA TECLA";:A$=INPUT$(1):RETURN
800 REM RUTINA ARRESTAR
805 CLS:PRESET(0,0)
810 PRINT #2, "INTENTO DE ARRESTO"
815 PRINT #2,""
820 IF CP<>R%(RL) OR ST<RL THEN PRINT #2, "EL LADRON NO ESTA AQUI.":TM=TM+2:GOSUB 1850:GOSUB 1800:RETURN
830 IF WA=0 THEN PRINT #2, "NECESITAS UNA ORDEN PRIMERO.":GOSUB 1800:RETURN
840 IF WA<>TH THEN GOTO 2080
850 GOSUB 2000:RETURN
880 CLS:PRESET(0,0)
890 PRINT #2, "CASO ABANDONADO.":gosub 790:END
900 REM RUTINA CARGAR DATOS INICIALES
905 TL=72:RL=5:MX=5:AR=0:IM=50:IC=0
910 OPEN "CITIES.DAT" FOR INPUT AS #1
915 LINE INPUT #1,A$:NC=VAL(A$)
920 DIM C$(NC),R%(RL),LP%(RL),U%(NC),V%(NC),FO%(3),P$(3),ZP$(3)
925 FOR I=1 TO NC:LINE INPUT #1,C$(I):NEXT I
930 CLOSE #1
935 OPEN "SUSPECT.DAT" FOR INPUT AS #1
940 LINE INPUT #1,A$:NS=VAL(A$)
945 DIM S$(NS),DT%(NS),MA%(NS),EV%(5),ES$(5),K$(5),AV$(20),TA%(5),SA%(5),PA%(5),O$(20)
955 FOR I=1 TO NS
960 LINE INPUT #1,S$(I)
965 FOR J=1 TO 5:LINE INPUT #1,A$:NEXT J
990 NEXT I
991 CLOSE #1
992 K$(1)="SEXO":K$(2)="PELO":K$(3)="VEHICULO"
993 K$(4)="RASGO":K$(5)="AFICION"
994 RETURN
1000 REM RUTINA CARGAR CIUDAD ACTUAL
1010 LC=CP:GOSUB 1300
1020 CC$=ZO$:CU$=ZU$:CM$=ZM$:CI$=ZI$
1025 D1$=Z1$:D2$=Z2$
1030 FOR I=1 TO 3:P$(I)=ZP$(I):NEXT I
1040 V%(CP)=1
1050 GOSUB 1200:GOSUB 2460
1060 RETURN
1100 REM RUTINA GENERAR CASO
1105 TL=72-AR*4
1110 FOR I=1 TO NC:U%(I)=0:V%(I)=0:NEXT I
1120 FOR I=1 TO RL
1130 N=INT(RND(1)*NC)+1
1140 IF U%(N)<>0 THEN GOTO 1130
1150 R%(I)=N:U%(N)=1
1160 NEXT I
1170 TH=INT(RND(1)*NS)+1
1172 IF DT%(TH)<>0 THEN GOTO 1170
1174 GOSUB 1780
1175 FOR I=1 TO 5:PA%(I)=I:NEXT I
1176 FOR I=1 TO 5:J=INT(RND(1)*5)+1:SW=PA%(I):PA%(I)=PA%(J):PA%(J)=SW:NEXT I
1178 FOR I=1 TO RL:LP%(I)=INT(RND(1)*3)+1:NEXT I
1180 CP=R%(1):ST=1:TM=0:WA=0
1190 FOR I=1 TO 5:EV%(I)=0:ES$(I)="":NEXT I
1195 RETURN
1200 REM RUTINA GENERAR VUELOS
1210 FOR I=1 TO 3:FO%(I)=0:NEXT I:NF=0
1220 IF CP=R%(ST) AND ST<RL THEN NF=1:FO%(1)=R%(ST+1)
1230 IF CP<>R%(ST) THEN NF=1:FO%(1)=R%(ST)
1240 IF NF>=3 THEN GOTO 1280
1250 N=INT(RND(1)*NC)+1
1260 IF N=CP THEN GOTO 1250
1265 DU=0
1270 FOR I=1 TO NF:IF FO%(I)=N THEN DU=1
1272 NEXT I
1274 IF DU=1 THEN GOTO 1250
1276 NF=NF+1:FO%(NF)=N:GOTO 1240
1280 FOR I=1 TO 3:J=INT(RND(1)*3)+1:SW=FO%(I):FO%(I)=FO%(J):FO%(J)=SW:NEXT I
1290 RETURN
