300 REM RUTINA INVESTIGAR
305 CLS:PRESET(0,0)
310 PRINT #2, "INVESTIGAR EN ";C$(CP)
315 PRINT #2,""
320 IF CP<>R%(ST) THEN PRINT #2, "NO HAY RASTRO CLARO AQUI.":TM=TM+2:GOSUB 1850:GOSUB 1800:RETURN
330 FOR I=1 TO 3:O$(I)=P$(I):NEXT I
335 MN=3:MY=2:GOSUB 2300
345 IF OP<1 OR OP>3 THEN PRINT #2, "LUGAR NO VALIDO":GOSUB 1800:RETURN
