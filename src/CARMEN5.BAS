1740 PRINT #2, K$(AT);": ";VV$:RETURN
1780 REM RUTINA CARGAR ATRIBUTOS OBJETIVO
1782 OPEN "SUSPECT.DAT" FOR INPUT AS #1
1783 LINE INPUT #1,A$
1784 FOR I=1 TO TH
1786 LINE INPUT #1,A$:FOR J=1 TO 5:LINE INPUT #1,B$:SA%(J)=VAL(B$):NEXT J
1788 NEXT I
1790 FOR J=1 TO 5:TA%(J)=SA%(J):NEXT J
1792 CLOSE #1:RETURN
