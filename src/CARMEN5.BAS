375 IF OP=LP%(ST) THEN GOSUB 1700:GOTO 390
376 CLS:PRESET(0,0)
377 IF OP=1 THEN PRINT #2, "EL LADRON ESTA EN ESTA CIUDAD."
380 IF OP=2 THEN PRINT #2, "SE OCULTA CON PASAPORTE FALSO."
385 IF OP=3 THEN PRINT #2, "NO PUEDE HUIR MUCHO MAS."
