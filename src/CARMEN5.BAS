4170 OPEN "CITYPOS.DAT" FOR INPUT AS #1:INPUT #1,NZ
4180 FOR K=1 TO NC
4190 INPUT #1,A$,XA,YA,XB,YB:SJ=-1
4200 IF K=OC THEN SJ=0
4210 FOR J=1 TO 3:IF K=FO%(J) THEN SJ=J
4220 NEXT J
4230 IF SJ>=0 THEN XX%(SJ)=XA:YY%(SJ)=YA:BX%(SJ)=XB:BY%(SJ)=YB
4240 NEXT K:CLOSE #1
4260 LINE(BX%(0),40+BY%(0))-(BX%(OP),40+BY%(OP)),0
4270 LC=0:GOSUB 4300
4280 FOR LC=1 TO 3:GOSUB 4300:NEXT LC
4290 TX=0:TY=6:RETURN
4300 REM RUTINA ESCRIBIR CIUDAD SOBRE MAPA
4310 IF LC=0 THEN K=OC ELSE K=FO%(LC)
4320 TX=XX%(LC):TY=40+YY%(LC):T$=C$(K)
4330 IF LC=0 THEN GOSUB 3630:GOTO 4350
4340 GOSUB 3660
4350 RETURN
4360 REM RUTINA ANIMACION PISTAS CIUDAD FINAL
4370 AY=154:AG=INT(RND(1)*3)+1
4380 IF AG=1 THEN AF=13:AN=4:AW=46:AH=43:AD=4:AJ=12:GOSUB 3740:RETURN
4390 IF AG=2 THEN GOSUB 4420:RETURN
4400 AF=4:AN=1:AW=68:AH=14:AD=1:AJ=12:GOSUB 4050:RETURN
4420 REM RUTINA ANIMACION FIJA PISTOLA
4430 AX=90:PX=90:AC=0
4440 AI=21+(AC MOD 3)
4450 U$=CHR$(255)+CHR$(3)+CHR$(AI)+CHR$(AX)+CHR$(AY)+CHR$(PX)+CHR$(AY)+CHR$(52)+CHR$(30):U$=USR(U$)
4460 TC=9:TK=TIME
4470 IF TIME=TK THEN GOTO 4470
4480 TK=TIME:TC=TC-1:IF TC>0 THEN GOTO 4470
4490 AC=AC+1:IF AC<6 THEN GOTO 4440
4500 U$=CHR$(255)+CHR$(2)+CHR$(AX)+CHR$(AY)+CHR$(52)+CHR$(30):U$=USR(U$):RETURN
4510 REM RUTINA ANIMACION CAPTURA CORRECTA
4520 AY=100:AF=24:AN=6:AW=50:AH=50:AD=2:AJ=4:GOSUB 4050:RETURN
4530 REM RUTINA ANIMACION POLICIA TRISTE
4540 AY=100:AF=43:AN=10:AW=42:AH=50:AD=2:AJ=4:GOSUB 4050:RETURN
